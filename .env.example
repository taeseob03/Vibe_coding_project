APP_ENV=development
# 임시 인증은 로컬 개발에서만 명시적으로 켭니다.
DEV_AUTH_ENABLED=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DATABASE_URL=sqlite:///./backend/data/campus.db
# 실제 AI 연결 단계에서만 사용합니다. 브라우저 코드에 넣지 마세요.
OPENAI_API_KEY=
LOCAL_WEB_PREVIEW_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
